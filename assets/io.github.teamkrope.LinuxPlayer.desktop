[Desktop Entry]
Type=Application
Name=LinuxPlayer
GenericName=Video Player
Comment=Watch local videos in a clean, modern player
Exec=linuxplayer %f
Icon=io.github.teamkrope.LinuxPlayer
Terminal=false
Categories=AudioVideo;Video;Player;
MimeType=video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/mpeg;video/ogg;video/x-flv;video/x-ms-wmv;
Keywords=video;movie;player;media;
StartupNotify=true
